Ref fk_auditoria_usuarios_condominios_auditoria_id: tb_log_auditoria_usuarios_condominios.auditoria_id - tb_log_auditoria.id_auditoria
Ref fk_auditoria_usuarios_condominios_usuario_condominio_id: tb_log_auditoria_usuarios_condominios.usuario_condominio_id > tb_rel_usuarios_condominios.id_usuario_condominio

// DAU
