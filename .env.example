# Use OU a DSN completa OU as variáveis separadas (a DSN tem prioridade).
# Valores no console da Aiven: Service > Overview > Connection information.
ECOCIENTE_DSN=postgres://avnadmin:SENHA@SEU-SERVICO.aivencloud.com:PORTA/defaultdb?sslmode=require

ECOCIENTE_DB_HOST=SEU-SERVICO.aivencloud.com
ECOCIENTE_DB_PORT=PORTA
ECOCIENTE_DB_NAME=defaultdb
ECOCIENTE_DB_USER=avnadmin
ECOCIENTE_DB_PASSWORD=SENHA
ECOCIENTE_DB_SSLMODE=require

# 1 = pula a confirmação antes do TRUNCATE (CI/automação)
# ECOCIENTE_ALLOW_RESET=1
